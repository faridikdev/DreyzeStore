    "Browse editor-selected apps, categories, and releases from the store server configured for this build." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Browse editor-selected apps, categories, and releases from the store server configured for this build." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Просматривайте подборки, категории и версии приложений из магазина, настроенного для этой сборки." } } } },
    "DreyzeStore checks the published checksum and package metadata before a download can be used." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "DreyzeStore checks the published checksum and package metadata before a download can be used." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перед использованием DreyzeStore сверяет опубликованную контрольную сумму и метаданные пакета." } } } },
    "On standard iOS, a paired Windows Companion signs locally with your own Apple development files and confirms installation from iPhone inventory." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On standard iOS, a paired Windows Companion signs locally with your own Apple development files and confirms installation from iPhone inventory." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "На обычной iOS сопряжённый Windows Companion подписывает приложение вашими файлами разработчика и подтверждает установку по списку приложений iPhone." } } } },
    "Pair only with a Windows PC you control. You can browse and download before pairing; installation needs a connected phone and valid signing setup." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pair only with a Windows PC you control. You can browse and download before pairing; installation needs a connected phone and valid signing setup." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключайте только свой Windows-компьютер. Каталог и загрузки доступны без сопряжения; для установки нужны подключённый iPhone и настроенная подпись." } } } },
    "Verification checks package integrity and metadata. It does not guarantee that the app is safe." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verification checks package integrity and metadata. It does not guarantee that the app is safe." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверка подтверждает целостность пакета и метаданные, но не гарантирует безопасность приложения." } } } }
