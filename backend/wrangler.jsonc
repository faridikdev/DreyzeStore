{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreyzestore-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "vars": {
    "ADMIN_ORIGINS": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dreyzestore-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_ASSETS",
      "bucket_name": "dreyzestore-assets-local"
    },
    {
      "binding": "STAGING_ASSETS",
      "bucket_name": "dreyzestore-staging-local"
    }
  ]
}
