{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DreyzeStore Companion",
  "version": "0.9.0-2",
  "identifier": "com.dreyzestore.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "DreyzeStore Companion", "width": 1180, "height": 780, "minWidth": 900, "minHeight": 640, "resizable": true }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/zsign"],
    "resources": ["licenses/*"]
  }
}
